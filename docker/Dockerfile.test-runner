FROM debian:bookworm-slim

RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install --yes --no-install-recommends \
        build-essential binutils-arm-none-eabi libelf1 \
    && rm -rf /var/lib/apt/lists/*

COPY tools/mgba-rom-test-hydra/ /tmp/hydra/
COPY tools/patchelf/ /tmp/patchelf/
RUN cc /tmp/hydra/main.c -o /usr/local/bin/mgba-rom-test-hydra -lm \
    && cc /tmp/patchelf/patchelf.c -o /usr/local/bin/patch-test-elf
COPY tools/mgba/mgba-rom-test /usr/local/bin/mgba-rom-test
COPY docker/run-tests.sh /usr/local/bin/run-tests

WORKDIR /work
ENTRYPOINT ["bash", "/usr/local/bin/run-tests"]
